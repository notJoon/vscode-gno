{
	"compilerOptions": {
		"module": "node20",
		"outDir": "out",
		"sourceMap": true,
		"target": "es2022",
		"lib": [
			"es2022"
		],
		"types": [
			"node",
			"mocha"
		],
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
	},
	"exclude": [
		"node_modules",
		"third_party"
	]
}
